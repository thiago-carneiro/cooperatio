// What pins what: the integrity structure of the material at v0.7.2.
digraph trust_chain {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=15, nodesep=0.25, ranksep=0.5, ratio=compress, size="6.4,9.4"];
  node  [fontname="Helvetica", fontsize=14, shape=box, style="rounded,filled", fillcolor="#F5F3EE", color="#555555"];
  edge  [fontname="Helvetica", fontsize=12, color="#555555", arrowsize=0.7];

  subgraph cluster_owner {
    label="outside the material: the owner"; style="rounded"; color="#BBBBBB"; fontcolor="#555555";
    familymap [label="family map + salt\n(letter → family)", fillcolor="#FBE9D7"];
    forbidden [label="forbidden identifiers list", fillcolor="#FBE9D7"];
  }

  subgraph cluster_material {
    label="inside the material"; style="rounded"; color="#BBBBBB"; fontcolor="#555555";
    registry [label="instances/registry.json\nsha256 pin per executed prior"];
    doc004 [label="method document of 004\n(distributed)"];
    canon [label="canon: section commitments\n(sha256 of each cited section of 004)\n+ the frozen records table"];
    frozen [label="90-review/* and the lessons above\nthe measured heading (never edited)"];
    rubricpin [label="rubric.sha256\n(frozen before the review)"];
    sens [label="sensitivity.md header\nvalidator · gates · canon · map sha256\ncase sha256 + case attestation per prior"];
    validator [label="validator.py\n(its sha must match the running one\nand the one next to the report)"];
    ledgers [label="three chained ledgers\nround-record · notes-status · owner-decisions\nprev = sha256 of every line above"];
    commitment [label="family_map_commitment\n(64 hex characters on every\nchained round line)"];
  }

  tag [label="a signed tag per version\n(the anchor outside the tree;\nrecommended, not yet made)", fillcolor="#FBE9D7", style="rounded,filled,dashed"];

  doc004 -> registry [label="pinned by"];
  doc004 -> canon [label="committed section by section"];
  doc004 -> sens [label="attested (every run recomputes)"];
  validator -> sens [label="provenance"];
  canon -> sens [label="provenance"];
  frozen -> canon [label="pinned in"];
  rubricpin -> canon [label="pinned in"];
  familymap -> commitment [label="salted sha256"];
  commitment -> ledgers [label="carried by"];
  forbidden -> validator [label="--forbidden (else the identifier\nhalf is pending, accepted by name)", style=dashed];
  ledgers -> tag [label="an edit that recomputes the\nchain shows only against it", style=dashed];
  frozen -> tag [label="a re-pin shows only in\nthe diff against it", style=dashed];
}
